# Server
PORT=8080
ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://user:pass@localhost:5432/dbname?sslmode=disable
DB_SCHEMA=routes

# Migrations — set true to run goose up on API startup
AUTO_MIGRATE=false

# Redis (direct mode — used when ENV=development or self-host)
REDIS_URL=redis://localhost:6379/0

# Redis Sentinel (used when ENV is production/staging)
REDIS_SENTINEL_HOST=
REDIS_SENTINEL_PORT=26379
REDIS_SENTINEL_USER=
REDIS_SENTINEL_MASTER=
REDIS_SENTINEL_PASS=
